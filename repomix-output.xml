<file path="change.py">
import os

# Configuration
SEARCH_TEXT = "https://amazonclone-sp.herokuapp.com"
REPLACE_TEXT = "http://localhost:8000"
TARGET_DIR = os.path.join(os.getcwd(), "client", "src")

def fix_urls():
    print(f"Searching for Heroku URLs in: {TARGET_DIR}")
    count = 0

    # Walk through the client/src directory
    for root, dirs, files in os.walk(TARGET_DIR):
        for file in files:
            # Check for relevant file types
            if file.endswith((".jsx", ".js", ".css")):
                file_path = os.path.join(root, file)
                
                try:
                    with open(file_path, "r", encoding="utf-8") as f:
                        content = f.read()

                    if SEARCH_TEXT in content:
                        new_content = content.replace(SEARCH_TEXT, REPLACE_TEXT)
                        with open(file_path, "w", encoding="utf-8") as f:
                            f.write(new_content)
                        # Removed emoji to prevent UnicodeEncodeError
                        print(f"SUCCESS - Updated: {file}")
                        count += 1
                except Exception as e:
                    print(f"Error processing {file}: {e}")

    if count == 0:
        print("No Heroku URLs found. They may have already been updated!")
    else:
        print(f"\nSuccessfully updated {count} files.")
        print("You can now restart your React app.")

if __name__ == "__main__":
    fix_urls()
</file>

